
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Pessoa {
 id Int @id @default (autoincrement())
 nome String 
 email String @unique
 cpf Cpf?
}

model Cpf {
  id Int @id @default (autoincrement())
  pessoaId Int @unique
  numero String @unique
  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
}